{
  "train": {
    "log_interval": 50,
    "eval_interval": 500,
    "eval_speaker_similarity": true,
    "eval_speaker_similarity_items": 4,
    "eval_speaker_model": "microsoft/wavlm-base-plus-sv",
    "seed": 114514,
    "epochs": 10000,
    "learning_rate": 3e-5,
    "betas": [0.9, 0.99],
    "eps": 1e-9,
    "batch_size": 6,
    "gradient_accumulation_steps": 1,
    "fp16_run": true,
    "half_type": "bf16",
    "lr_decay_steps": 100000,
    "segment_size": 10240,
    "init_lr_ratio": 1,
    "warmup_epochs": 5,
    "c_mel": 45,
    "c_kl": 1.0,
    "c_speaker_adv": 0.1,
    "c_bigvgan_mel": 45.0,
    "disc_start_step": 10000,
    "use_sr": true,
    "max_speclen": 512,
    "port": "8001",
    "keep_ckpts": 500,
    "all_in_mem": false,
    "num_workers": 4,
    "vol_aug": true,
    "feature_aug": false,
    "feature_aug_noise": 0.05,
    "feature_aug_time_mask": 0,
    "feature_aug_channel_dropout": 0.05,
    "optimizer": "lion",
    "weight_decay": 0.1,

    "bigvgan_strategy": {
      "_comment": "BigVGAN 自动分阶段训练策略 - 集中配置所有相关参数",
      "mode": "auto_finetune",
      "_mode_options": "frozen(永久冻结) | auto_finetune(自动两阶段,推荐) | finetune_from_start(从头解冻)",

      "phase1_disc_start": 90000,
      "_phase1_disc_start_comment": "Phase1 判别器延后启动步数(给 MelHead 对齐窗口),仅 auto_finetune 模式生效",

      "disc_warmup_steps": 10000,
      "_disc_warmup_steps_comment": "no-GAN warmup:前 N 步彻底关闭所有判别器,只跑 mel+KL+f0+bigvgan_mel,让 MelHead 和 source gate 先稳定;0=关闭",

      "phase1_mel_target": 0.35,
      "_phase1_mel_target_comment": "Phase1→Phase2 切换阈值: loss/g/bigvgan_mel 原始 L1 < 此值时自动解冻",

      "phase2_vocoder_lr": 1e-5,
      "_phase2_vocoder_lr_comment": "Phase2 声码器固定微调 lr(不跟 cosine 衰减),防灾难性遗忘",

      "grad_clip_norm": 5.0,
      "_grad_clip_norm_comment": "梯度 L2 裁剪阈值,null=只测量不裁;推荐 5.0 稳定训练",

      "use_mel_loss": true,
      "_use_mel_loss_comment": "是否用 80-band 穿透声码器的 loss_mel(路线1可关掉)",

      "use_bigvgan_mel_loss": true,
      "_use_bigvgan_mel_loss_comment": "是否用 128-band 直接监督 loss_bigvgan_mel"
    }
  },
  "data": {
    "training_files": "projects/your_project/filelists/train.txt",
    "validation_files": "projects/your_project/filelists/val.txt",
    "max_wav_value": 32768.0,
    "sampling_rate": 44100,
    "filter_length": 2048,
    "hop_length": 512,
    "win_length": 2048,
    "n_mel_channels": 80,
    "mel_fmin": 0.0,
    "mel_fmax": 22050,
    "unit_interpolate_mode": "nearest"
  },
  "model": {
    "inter_channels": 192,
    "hidden_channels": 192,
    "filter_channels": 768,
    "n_heads": 2,
    "n_layers": 6,
    "kernel_size": 3,
    "p_dropout": 0.1,
    "resblock": "1",
    "resblock_kernel_sizes": [3, 7, 11],
    "resblock_dilation_sizes": [[1, 3, 5], [1, 3, 5], [1, 3, 5]],
    "upsample_rates": [8, 8, 2, 2, 2],
    "upsample_initial_channel": 512,
    "upsample_kernel_sizes": [16, 16, 4, 4, 4],
    "n_layers_q": 3,
    "n_layers_trans_flow": 3,
    "n_flow_layer": 4,
    "use_spectral_norm": false,
    "gin_channels": 768,
    "ssl_dim": 768,
    "n_speakers": 1,
    "vocoder_name": "bigvgan-v2",
    "bigvgan_model": "nvidia/bigvgan_v2_44khz_128band_512x",
    "bigvgan_mel_channels": 128,
    "bigvgan_trainable": false,
    "_bigvgan_trainable_comment": "初始冻结,auto_finetune 模式会在 Phase2 自动解冻",
    "bigvgan_cuda_kernel": false,
    "speech_encoder": "vec768l12mix",
    "whisper_path": "pretrain/large-v3.pt",
    "speaker_embedding": false,
    "vol_embedding": true,
    "use_depthwise_conv": false,
    "flow_share_parameter": false,
    "use_automatic_f0_prediction": true,
    "use_transformer_flow": false,
    "use_speaker_adversarial": false,
    "use_cqt_disc": true,
    "use_mrd_disc": true,
    "use_mbd_disc": false,
    "speaker_adversarial_weight": 1.0
  },
  "spk": {
    "speaker_name": 0
  }
}
